FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04



# Install Python and dependencies

RUN apt-get update && apt-get install -y \

    python3 \

    python3-pip \

    build-essential \

    curl \

    git \

    && rm -rf /var/lib/apt/lists/*



# Create symlink for python

RUN ln -sf /usr/bin/python3 /usr/bin/python



WORKDIR /app



# Copy and install requirements

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt



# Pre-download all ML models so the first user query avoids cold-start
# latency (combined ~20-30s on CPU) that otherwise trips reverse-proxy
# timeouts (504). Cache lives in /root/.cache and ships inside the image.
RUN python3 -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('intfloat/multilingual-e5-large')"
RUN python3 -c "from sentence_transformers import CrossEncoder; CrossEncoder('BAAI/bge-reranker-v2-m3', max_length=512)"
RUN python3 -c "from fastembed import SparseTextEmbedding; SparseTextEmbedding(model_name='Qdrant/bm25')"

# Copy application code

COPY . .


ENV PYTHONPATH=/app/src:/app/src/db
# Environment variables

ENV PYTHONUNBUFFERED=1

ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

ENV CUDA_VISIBLE_DEVICES=0

ENV CUDA_HOME=/usr/local/cuda

ENV PATH=${CUDA_HOME}/bin:${PATH}

ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}



# Qdrant connection

ENV QDRANT_HOST=qdrant

ENV QDRANT_PORT=6333



EXPOSE 8000



HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \

    CMD curl -f http://localhost:8000/health/live || exit 1



WORKDIR /app/src



# Single worker on purpose: the request path is CPU-bound ML inference
# (E5 embed + cross-encoder rerank). On a low-core host, multiple workers
# contend for the same cores and oversubscribe torch threads, making every
# request slower and doubling model memory. One worker lets the models use
# all cores without contention. Raise this only if cores >> 4 and you need
# request concurrency.
CMD ["uvicorn", "db.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
