# Docker Compose Environment Configuration
# Copy this file to .env.docker and fill in your values

# AWS S3 Configuration (required for document storage)
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_DEFAULT_REGION=ap-south-1

# Qdrant Configuration (Docker service name)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Gemini API Configuration (required for LLM answer generation)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Hugging Face token for model downloads
# HF_TOKEN=your-huggingface-token
