# AWS S3 Configuration (required for document storage)
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_DEFAULT_REGION=ap-south-1

# Qdrant Configuration (local instance)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Gemini API Configuration (required for LLM answer generation)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Hugging Face token for model downloads
# HF_TOKEN=your-huggingface-token

# Retrieval debug — logs dense vs sparse top-10 per query (verbose, dev only)
# RAG_DEBUG=1

# Cross-encoder reranker (BAAI/bge-reranker-v2-m3 default, multilingual incl. Tamil)
# Set ENABLE_RERANKER=0 to fall back to lexical filter
ENABLE_RERANKER=1
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_TOP_IN=30
# RERANKER_TOP_OUT=5            # upper cap on returned sources
# RERANKER_MIN_OUT=3            # always return at least this many when reranker ran
# RERANKER_SCORE_FLOOR_RATIO=0.4  # drop docs scoring < 40% of top score
# RERANKER_GAP_RATIO=0.5          # drop after a > 50% drop from previous
# RERANKER_MAX_CHARS=800
# RERANKER_BATCH=16
# Pin candidates whose heading contains a multi-token query phrase
# (e.g. heading literally equals "மே தினம்"). Forces them into the
# reranker pool even if they ranked deep in retrieval.
# RERANKER_PIN_HEADING_MATCHES=1

# ── Dataset access (corpus download gating) ────────────────────────────────
# Secret used to sign download links. REQUIRED in production — when unset an
# ephemeral secret is generated and all issued links break on API restart.
DATASET_TOKEN_SECRET=change-me-to-a-long-random-string
# Download-link lifetime in hours (default 168 = 7 days)
DATASET_LINK_TTL_HOURS=168
# Where request notifications are sent, and the address shown in the UI
DATASET_CONTACT_EMAIL=contact@ponniarchive.com
# Base URL used to build emailed download links
DATASET_PUBLIC_BASE_URL=https://ponniarchive.com
# S3 key of the corpus bundle served to approved requesters
DATASET_BUNDLE_KEY=Proof_Read_Bundles/ponni-corpus-v1.zip
# S3 prefix where request records are stored
DATASET_REQUESTS_PREFIX=dataset_requests/
# Email backend: ses | smtp | log  (log = record only, nothing sent)
DATASET_EMAIL_BACKEND=log
# SES backend
# SES_REGION=ap-south-1
# SES_FROM=contact@ponniarchive.com
# SMTP backend
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_FROM=contact@ponniarchive.com
